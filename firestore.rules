rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/local-user/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'naingkhantab@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
